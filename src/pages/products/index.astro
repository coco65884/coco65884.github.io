---
import Base from "../../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const products = [
  // 一旦非公開: Closway のカードを Products 一覧から除外中
  // (各ページ /products/closway/ 配下は引き続き公開)
  // {
  //   name: "Closway",
  //   href: `${base}/products/closway/`,
  //   description:
  //     "服を撮るだけで AI が属性自動抽出する iOS クローゼット管理アプリ",
  //   links: [
  //     {
  //       label: "Privacy Policy",
  //       href: `${base}/products/closway/privacy-policy/`,
  //     },
  //     {
  //       label: "Terms",
  //       href: `${base}/products/closway/terms/`,
  //     },
  //     {
  //       label: "Support",
  //       href: `${base}/products/closway/support/`,
  //     },
  //   ],
  // },
  {
    name: "Tokyo Master",
    href: `${base}/products/tokyo-master/`,
    description: "東京都の地理を学ぶためのアプリ",
    links: [
      {
        label: "Privacy Policy",
        href: `${base}/products/tokyo-master/privacy-policy/`,
      },
    ],
  },
  {
    name: "Mini Todo",
    href: `${base}/products/mini-todo/`,
    description: "macOS用の軽量Todoリスト&メモアプリ",
    links: [
      {
        label: "GitHub",
        href: "https://github.com/coco65884/mini-todo",
      },
    ],
  },
];
---

<Base title="Products - coco">
  <h1>Products</h1>

  <ul class="product-list">
    {
      products.map((product) => (
        <li class="product-card">
          <h2>
            <a href={product.href}>{product.name}</a>
          </h2>
          <p>{product.description}</p>
          <div class="product-links">
            {product.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .product-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .product-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .product-card h2 {
    margin-top: 0;
  }

  .product-links {
    display: flex;
    gap: 1rem;
  }
</style>
